# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/razorpay_recovery?schema=public"

# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Razorpay Live Integration Toggle ("true" to create real test-mode Payment Links on NUDGE_SENT, "false" for safe synthetic mode)
RAZORPAY_LIVE_MODE="false"

